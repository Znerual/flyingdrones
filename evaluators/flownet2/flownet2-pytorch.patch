--- a/networks/pytorch_fallbacks.py
+++ b/networks/pytorch_fallbacks.py
@@ -0,0 +1,87 @@
+"""Pure PyTorch fallbacks for the FlowNet2 custom CUDA ops.
+
+Used when CUDA extensions cannot be compiled (e.g., no nvcc/Thrust headers).
+Slower but numerically equivalent for inference.
+"""
+import torch
+import torch.nn.functional as F
+from torch.nn.modules.module import Module
+from torch.autograd import Function
+
+
+# ---------------------------------------------------------------------------
+# ChannelNorm: per-pixel L2 norm across channels
+# ---------------------------------------------------------------------------
+
+class ChannelNormFallback(Module):
+    def __init__(self, norm_deg=2):
+        super().__init__()
+        self.norm_deg = norm_deg
+
+    def forward(self, input1):
+        return torch.norm(input1, p=self.norm_deg, dim=1, keepdim=True)
+
+
+# ---------------------------------------------------------------------------
+# Resample2d: bilinear warp of input1 using displacement field from input2
+# ---------------------------------------------------------------------------
+
+class Resample2dFallback(Module):
+    def __init__(self, kernel_size=1, bilinear=True):
+        super().__init__()
+        self.kernel_size = kernel_size
+        self.bilinear = bilinear
+
+    def forward(self, input1, input2):
+        B, C, H, W = input1.shape
+        _, _, H2, W2 = input2.shape
+
+        y_base = torch.arange(H2, device=input1.device, dtype=input1.dtype)
+        x_base = torch.arange(W2, device=input1.device, dtype=input1.dtype)
+        grid_y, grid_x = torch.meshgrid(y_base, x_base, indexing='ij')
+
+        new_x = grid_x.unsqueeze(0) + input2[:, 0]
+        new_y = grid_y.unsqueeze(0) + input2[:, 1]
+
+        new_x_norm = new_x / (W - 1) * 2 - 1
+        new_y_norm = new_y / (H - 1) * 2 - 1
+
+        grid = torch.stack([new_x_norm, new_y_norm], dim=-1)
+        return F.grid_sample(input1, grid, mode='bilinear',
+                             padding_mode='zeros', align_corners=True)
+
+
+# ---------------------------------------------------------------------------
+# Correlation: dot-product correlation with displacement search
+#   pad_size=20, kernel_size=1, max_displacement=20, stride1=1, stride2=2
+#   output channels = (2*(max_displacement//stride2) + 1)^2
+# ---------------------------------------------------------------------------
+
+class CorrelationFallback(Module):
+    def __init__(self, pad_size=0, kernel_size=0, max_displacement=0,
+                 stride1=1, stride2=2, corr_multiply=1):
+        super().__init__()
+        self.pad_size = pad_size
+        self.max_displacement = max_displacement
+        self.stride1 = stride1
+        self.stride2 = stride2
+
+    def forward(self, input1, input2):
+        B, C, H, W = input1.shape
+        d = self.max_displacement
+        s = self.stride2
+        # Pad input2 with max_displacement on each side
+        input2_pad = F.pad(input2, [d, d, d, d])
+
+        corrs = []
+        for ty in range(-d, d + 1, s):
+            for tx in range(-d, d + 1, s):
+                # Sample input2 at displaced positions
+                shifted = input2_pad[:, :,
+                                     d + ty: d + ty + H,
+                                     d + tx: d + tx + W]
+                # Dot product and average over channels
+                corr = (input1 * shifted).sum(dim=1, keepdim=True) / C
+                corrs.append(corr)
+
+        return torch.cat(corrs, dim=1)  # (B, (2d/s+1)^2, H, W)
